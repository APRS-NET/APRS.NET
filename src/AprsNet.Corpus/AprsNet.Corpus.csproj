<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Helpers for APRS packet test corpora: the corpus line format (a UTC timestamp and the raw packet, in Latin-1) and an anonymizer that replaces callsigns, station names and e-mail addresses with same-length pseudonyms.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
