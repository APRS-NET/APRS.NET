<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>A local APRS-IS server: serves packets from APRS-IS and KISS TNCs, each heard once, to APRS-IS clients, each with its own filter, with history and a station store.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="AprsNet.Gateway.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../AprsNet.AprsIsTcpClient/AprsNet.AprsIsTcpClient.csproj" />
    <ProjectReference Include="../AprsNet.Filters/AprsNet.Filters.csproj" />
  </ItemGroup>
</Project>
