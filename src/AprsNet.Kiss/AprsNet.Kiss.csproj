<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Talk to a KISS TNC, such as Dire Wolf: read the APRS packets it hears and send packets for it to transmit, over TCP with reconnects or over any stream (serial, Bluetooth), with a transmit rate limit. Also a KISS TCP server to share one TNC between apps.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="AprsNet.Kiss.Tests" />
    <InternalsVisibleTo Include="AprsNet.Kiss.Serial" />
    <InternalsVisibleTo Include="aprscli" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../AprsNet.Ax25/AprsNet.Ax25.csproj" />
  </ItemGroup>
</Project>
