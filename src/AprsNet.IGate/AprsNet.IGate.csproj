  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../AprsNet.Ax25/AprsNet.Ax25.csproj" />
    <ProjectReference Include="../AprsNet.Packets/AprsNet.Packets.csproj" />
  </ItemGroup>
</Project>
