<Project>
  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <!-- Audit transitive packages too (newer SDKs default to this; set it so every SDK behaves the same). With
         TreatWarningsAsErrors, a known-vulnerable package fails the build. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <!-- Deterministic /_/ source paths for shipped code only: test projects keep real paths so failure annotations
         (GitHubActionsTestLogger) point at files GitHub can link. -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true' And !$(MSBuildProjectName.EndsWith('Tests'))"
      >true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Derek Rowland</Authors>
    <Copyright>Copyright (c) Derek Rowland 2026</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <!-- Checks packages on pack (same API across target frameworks, required files). After 1.0, also set
         PackageValidationBaselineVersion to flag breaking changes against the last release. -->
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <!-- Banned APIs (RS0030) for shipped code only: src/ and apps/. Tests and tools may use real time and the console. -->
  <PropertyGroup>
    <AprsNetProjectArea>$([MSBuild]::MakeRelative('$(MSBuildThisFileDirectory)', '$(MSBuildProjectDirectory)'))</AprsNetProjectArea>
  </PropertyGroup>

  <ItemGroup Condition="$(AprsNetProjectArea.StartsWith('src')) Or $(AprsNetProjectArea.StartsWith('apps'))">
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
  </ItemGroup>

  <ItemGroup Condition="$(AprsNetProjectArea.StartsWith('src'))">
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.Library.txt" />
  </ItemGroup>
</Project>
