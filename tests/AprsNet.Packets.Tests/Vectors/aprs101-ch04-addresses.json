{
  "$schema": "./vectors.schema.json",
  "vectors": [
    {
      "id": "ch04.dest-generic-beacon",
      "title": "Generic BEACON destination",
      "spec": {
        "document": "APRS101",
        "page": 13,
        "section": "Generic APRS Destination Addresses"
      },
      "status": "derived",
      "features": [
        "dest.generic",
        "status"
      ],
      "packet": "N0CALL>BEACON:>Hello",
      "expect": {
        "type": "status",
        "destination": {
          "kind": "generic"
        },
        "text": "Hello"
      }
    },
    {
      "id": "ch04.dest-software-version",
      "title": "Software version destination APM326",
      "spec": {
        "document": "APRS101",
        "page": 14,
        "section": "APRS Software Version Number"
      },
      "status": "normative",
      "features": [
        "dest.software",
        "status"
      ],
      "packet": "N0CALL>APM326:>Net Control",
      "expect": {
        "type": "status",
        "destination": {
          "kind": "software",
          "id": "APM326"
        }
      }
    },
    {
