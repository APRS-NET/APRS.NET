      "title": "Symbol from GPSxyz destination (GPSMV = car)",
      "spec": {
        "document": "APRS101",
        "page": 92,
        "section": "Symbols in the AX.25 Destination Address"
      },
      "status": "normative",
      "features": [
        "dest.symbol.gpsxyz",
        "nmea.rmc"
      ],
      "packet": "N0CALL>GPSMV:$GPRMC,063909,A,3349.4302,N,11700.3721,W,43.022,89.3,291099,13.6,E*52",
      "expect": {
        "type": "nmea",
        "symbol": {
          "table": "/",
          "code": ">",
          "source": "destination"
        }
      }
    },
    {
