        "symbol": {
          "table": "\\",
          "code": ">"
        }
      }
    },
    {
      "id": "ch20.precedence-info",
      "title": "Symbol precedence: information field wins",
      "spec": {
        "document": "APRS101",
        "page": 93,
        "section": "Symbol Precedence"
      },
      "status": "normative",
      "features": [
        "dti.pos.nots.nomsg",
        "dest.symbol.gpsxyz"
      ],
      "packet": "G3NRW-7>GPSMV:!0123.45N/01234.56Wj",
      "expect": {
        "type": "position",
        "symbol": {
          "table": "/",
          "code": "j",
          "source": "information"
        }
      }
    },
    {
      "id": "ch20.precedence-destination",
      "title": "Symbol precedence: destination beats source SSID",
      "spec": {
        "document": "APRS101",
        "page": 93,
        "section": "Symbol Precedence"
      },
      "status": "derived",
      "features": [
        "dest.symbol.gpsxyz",
        "nmea.rmc"
      ],
      "packet": "G3NRW-7>GPSMV:$GPRMC,063909,A,3349.4302,N,11700.3721,W,43.022,89.3,291099,13.6,E*52",
      "expect": {
        "type": "nmea",
        "symbol": {
          "table": "/",
          "code": ">",
          "source": "destination"
        }
      }
    }
  ]
