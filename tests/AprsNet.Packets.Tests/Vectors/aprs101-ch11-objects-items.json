{
  "$schema": "./vectors.schema.json",
  "vectors": [
    {
      "id": "ch11.object-live",
      "title": "Live object with course/speed",
      "spec": {
        "document": "APRS101",
        "page": 58,
        "section": "Object Report Format"
      },
      "status": "normative",
      "features": [
        "object.live",
        "time.dhm.zulu",
        "ext.csespd"
      ],
      "packet": "N0CALL>APRS:;LEADER   *092345z4903.50N/07201.75W>088/036",
      "expect": {
        "type": "object",
        "name": "LEADER",
        "alive": true,
        "timestamp": {
          "format": "DHM",
          "day": 9,
          "hour": 23,
          "minute": 45,
          "zone": "zulu"
        },
        "latitude": 49.058333,
        "longitude": -72.029167,
        "symbol": {
          "table": "/",
          "code": ">"
        },
        "course": 88,
        "speed": 36
      },
      "notes": "Object names are 9 characters; trailing pad spaces are not part of the name (APRS 1.1 names-and-spaces)."
    },
    {
      "id": "ch11.object-killed",
      "title": "Killed object",
