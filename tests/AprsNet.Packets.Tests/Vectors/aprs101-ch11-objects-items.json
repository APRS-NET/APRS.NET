    {
      "id": "ch11.area-ellipse",
      "title": "Area object: high-intensity cyan filled ellipse",
      "spec": {
        "document": "APRS101",
        "page": 61,
        "section": "Area Objects"
      },
      "status": "normative",
      "features": [
        "object.live",
        "ext.area"
      ],
      "packet": "N0CALL>APRS:;SEARCH   *092345z4903.50N\\07201.75Wl710/310",
      "expect": {
        "type": "object",
        "name": "SEARCH",
        "symbol": {
          "table": "\\",
          "code": "l"
        },
        "area": {
          "type": 7,
          "color": 3,
          "yy": 10,
          "xx": 10
        }
      },
      "notes": "APRS 1.1 areaobjects.txt corrects the size formula (offset = n^2/1500) and the reference corner; only raw yy/xx are asserted."
    },
