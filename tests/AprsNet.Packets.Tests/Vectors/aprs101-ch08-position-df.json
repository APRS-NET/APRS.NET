{
  "$schema": "./vectors.schema.json",
  "vectors": [
    {
      "id": "ch08.pos-nots-nomsg-comment",
      "title": "Position, no timestamp, no messaging, comment",
      "spec": {
        "document": "APRS101",
        "page": 32,
        "section": "Position Reports"
      },
      "status": "normative",
      "features": [
        "dti.pos.nots.nomsg",
        "pos.uncompressed"
      ],
      "packet": "N0CALL>APRS:!4903.50N/07201.75W-Test 001234",
      "expect": {
        "type": "position",
        "messaging": false,
        "latitude": 49.058333,
        "longitude": -72.029167,
        "symbol": {
          "table": "/",
          "code": "-"
        },
        "comment": "Test 001234"
      }
    },
    {
      "id": "ch08.pos-nots-altitude",
      "title": "Position with altitude in comment",
      "spec": {
        "document": "APRS101",
        "page": 32,
