      }
    },
    {
      "id": "ch08.pos-ambiguity-degree",
      "title": "Position to nearest degree (lat and lon spaced)",
      "spec": {
        "document": "APRS101",
        "page": 32,
        "section": "Position Reports"
      },
      "status": "normative",
      "features": [
        "dti.pos.nots.nomsg",
        "pos.ambiguity"
      ],
      "packet": "N0CALL>APRS:!49  .  N/072  .  W-",
      "expect": {
        "type": "position",
        "latitude": 49.0,
        "longitude": -72.0,
        "ambiguity": 4,
        "symbol": {
          "table": "/",
          "code": "-"
        }
      }
    },
    {
      "id": "ch08.pos-x1j-header",
      "title": "Position with X1J node header before '!'",
      "spec": {
        "document": "APRS101",
        "page": 32,
        "section": "Position Reports"
      },
      "status": "superseded",
      "features": [
        "dti.x1j"
      ],
      "packet": "N0CALL>APRS:TheNet X-1J4  (BFLD)!4903.50N/07201.75Wn",
      "expect": {
        "type": "position",
        "latitude": 49.058333,
        "longitude": -72.029167,
        "symbol": {
          "table": "/",
          "code": "n"
        }
      },
      "notes": "APRS 1.1 errata (A11-ERR-01): the X1J exception was deprecated in 2012; '!' is only a DTI at offset 0. A strict 1.1 decoder treats this as a non-APRS beacon."
    },
