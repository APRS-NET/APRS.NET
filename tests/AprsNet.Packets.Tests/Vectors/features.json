      "page": 55,
      "target": "info",
      "match": "^[`'].{8}[>\\]]?[A-R]{2}[0-9]{2}(?:[A-X]{2})?/G"
    },
    {
      "id": "mice.telemetry.legacy",
      "title": "Mic-E telemetry ('/` + hex) — superseded by type codes",
      "page": 54,
      "target": "info",
      "match": "^[`'].{8}(?:`[0-9A-F]{4}|'[0-9A-F]{10})$"
    },
    {
      "id": "mice.truncated",
      "title": "Mic-E information field shorter than 9 bytes",
      "page": 47,
      "target": "info",
      "match": "^[`'].{0,7}$"
    },
    {
      "id": "object.live",
      "title": "Object, live (*)",
      "page": 58,
      "target": "info",
      "match": "^;.{9}\\*"
    },
    {
      "id": "object.killed",
      "title": "Object, killed (_)",
      "page": 58,
      "target": "info",
      "match": "^;.{9}_"
    },
    {
      "id": "object.compressed",
      "title": "Object with compressed position",
      "page": 58,
      "target": "info",
      "match": "^;.{9}[*_][0-9]{6}[zh/][/\\\\A-Za-j][!-{]{8}"
    },
    {
      "id": "item.live",
      "title": "Item, live (!)",
      "page": 59,
      "target": "info",
      "match": "^\\)[^!_]{3,9}!"
    },
    {
      "id": "item.killed",
      "title": "Item, killed (_)",
      "page": 59,
      "target": "info",
      "match": "^\\)[^!_]{3,9}_"
    },
    {
      "id": "item.compressed",
      "title": "Item with compressed position",
      "page": 59,
      "target": "info",
      "match": "^\\)[^!_]{3,9}[!_][/\\\\A-Za-j][!-{]{8}"
    },
    {
      "id": "signpost",
      "title": "Signpost \\m with {xxx} overlay",
      "page": 61,
      "target": "info",
      "match": "\\\\[0-9 ]{5}\\.[0-9 ]{2}[EW]m.*\\{[^}]{1,3}\\}"
    },
    {
      "id": "wx.raw.ultimeter",
      "title": "Raw Ultimeter 2000 weather (!! or $ULTW)",
      "page": 62,
      "target": "info",
      "match": "^(?:!!|\\$ULTW)"
    },
    {
      "id": "wx.raw.peet",
      "title": "Raw Peet Bros U-II weather (# or *)",
      "page": 62,
      "target": "info",
      "match": "^[#*][0-9A-F]{10,}"
    },
    {
      "id": "wx.positionless",
      "title": "Positionless weather report (_MDHM)",
      "page": 63,
      "target": "info",
      "match": "^_[0-9]{8}c"
    },
    {
      "id": "wx.complete",
      "title": "Complete weather report (position + _ symbol)",
      "page": 65,
      "target": "info",
      "match": "(?:^(?:[!=]|[/@][0-9]{6}[zh/])[0-9 ]{4}\\.[0-9 ]{2}[NS][/\\\\0-9A-Z][0-9 ]{5}\\.[0-9 ]{2}[EW]|^(?:[!=]|[/@][0-9]{6}[zh/])[/\\\\A-Za-j][!-{]{8}|^;.{9}[*_][0-9]{6}[zh/](?:[0-9 ]{4}\\.[0-9 ]{2}[NS][/\\\\0-9A-Z][0-9 ]{5}\\.[0-9 ]{2}[EW]|[/\\\\A-Za-j][!-{]{8}))_"
    },
    {
      "id": "wx.temp.negative",
      "title": "Weather temperature below zero (t-nn)",
      "page": 64,
      "target": "info",
      "match": "t-[0-9]{2}"
    },
    {
      "id": "wx.missing",
      "title": "Weather field with no data (dots or spaces)",
      "page": 64,
      "target": "info",
      "match": "(?:[cstgrpPhb]\\.{2,}|_\\.{3}/\\.{3})"
    },
    {
      "id": "wx.rain",
      "title": "Weather rain fields r/p/P",
      "page": 64,
      "target": "info",
      "match": "[rpP][0-9]{3}"
    },
    {
      "id": "wx.humidity",
      "title": "Weather humidity hnn",
      "page": 64,
      "target": "info",
      "match": "_.*h[0-9]{2}"
    },
    {
      "id": "wx.pressure",
      "title": "Weather barometric pressure bnnnnn",
      "page": 64,
      "target": "info",
      "match": "_.*b[0-9]{5}"
    },
    {
      "id": "wx.luminosity",
      "title": "Weather luminosity L/l",
      "page": 64,
      "target": "info",
      "match": "_.*[Ll][0-9]{3}"
    },
    {
      "id": "wx.object",
      "title": "Weather data in an object",
      "page": 65,
      "target": "info",
      "match": "^;.{9}\\*[0-9]{6}[zh/](?:[0-9 ]{4}\\.[0-9 ]{2}[NS][/\\\\0-9A-Z][0-9 ]{5}\\.[0-9 ]{2}[EW]|[/\\\\A-Za-j][!-{]{8})_"
    },
    {
      "id": "storm",
      "title": "Storm data /TS|HC|TD/www^GGG/pppp>RRR&rrr%ggg",
      "page": 67,
      "target": "info",
      "match": "/(?:TS|HC|TD)/[0-9]{3}\\^[0-9]{3}/[0-9]{4}>[0-9]{3}&[0-9]{3}"
    },
    {
      "id": "tlm.report",
      "title": "Telemetry report T#sss,…",
      "page": 68,
      "target": "info",
      "match": "^T#(?:[0-9]{3}|MIC),?[0-9]{1,3}(?:,[0-9.]*){4}"
    },
    {
      "id": "tlm.mic",
      "title": "Telemetry report with MIC sequence",
      "page": 68,
      "target": "info",
      "match": "^T#MIC"
    },
    {
      "id": "tlm.parm",
      "title": "Telemetry PARM. message",
      "page": 69,
      "target": "info",
      "match": "^:.{9}:PARM\\."
    },
    {
      "id": "tlm.unit",
      "title": "Telemetry UNIT. message",
      "page": 69,
      "target": "info",
      "match": "^:.{9}:UNIT\\."
    },
    {
      "id": "tlm.eqns",
      "title": "Telemetry EQNS. message",
      "page": 70,
      "target": "info",
      "match": "^:.{9}:EQNS\\."
    },
    {
      "id": "tlm.bits",
      "title": "Telemetry BITS. message",
      "page": 70,
      "target": "info",
      "match": "^:.{9}:BITS\\."
    },
    {
      "id": "msg",
      "title": "Message (addressee + text)",
      "page": 71,
      "target": "info",
      "match": "^:(?!BLN|NWS)[^:]{9}:(?!ack|rej|\\?)"
    },
    {
      "id": "msg.id",
      "title": "Message with message identifier {xxxxx",
      "page": 71,
      "target": "info",
      "match": "^:(?!BLN|NWS)[^:]{9}:(?!ack|rej).*\\{[A-Za-z0-9]{1,5}$"
    },
    {
      "id": "msg.ack",
      "title": "Message acknowledgement",
      "page": 72,
      "target": "info",
      "match": "^:[^:]{9}:ack[A-Za-z0-9}]{1,7}"
    },
    {
      "id": "msg.rej",
      "title": "Message rejection",
      "page": 72,
      "target": "info",
      "match": "^:[^:]{9}:rej[A-Za-z0-9}]{1,7}"
    },
    {
      "id": "bulletin",
      "title": "General bulletin BLNn",
      "page": 73,
      "target": "info",
      "match": "^:BLN[0-9] {5}:"
    },
    {
      "id": "announcement",
      "title": "Announcement BLNx",
      "page": 73,
      "target": "info",
      "match": "^:BLN[A-Z] {5}:"
    },
    {
      "id": "bulletin.group",
      "title": "Group bulletin BLNnNAME",
      "page": 74,
      "target": "info",
      "match": "^:BLN[0-9](?! {5})[A-Za-z0-9 ]{5}:"
    },
    {
      "id": "nws",
      "title": "NWS bulletin NWS-xxxxx",
      "page": 74,
      "target": "info",
      "match": "^:NWS[-_][A-Z ]{5}:"
    },
    {
      "id": "nts",
      "title": "NTS radiogram line (Nx\\)",
      "page": 75,
      "target": "info",
      "match": "^:[^:]{9}:N[#APSR1-6]\\\\"
    },
    {
      "id": "capabilities",
      "title": "Station capabilities (<)",
      "page": 77,
      "target": "info",
      "match": "^<"
    },
    {
      "id": "query.general",
      "title": "General query ?TYPE?",
      "page": 78,
      "target": "info",
      "match": "^\\?[A-Z]+\\?"
    },
    {
      "id": "query.footprint",
      "title": "General query with target footprint",
      "page": 78,
      "target": "info",
      "match": "^\\?[A-Z]+\\? ?-?[0-9.]+,-?[0-9.]+,[0-9]{4}"
    },
    {
      "id": "query.directed",
      "title": "Directed station query (message ?APRSx)",
      "page": 79,
      "target": "info",
      "match": "^:[^:]{9}:\\?(?:APRS[DHMOPST]|PING\\?)"
    },
    {
      "id": "status",
      "title": "Status report (>)",
      "page": 80,
      "target": "info",
      "match": "^>"
    },
    {
      "id": "status.timestamp",
      "title": "Status with DHM zulu timestamp",
      "page": 80,
      "target": "info",
      "match": "^>[0-9]{6}z"
    },
    {
      "id": "status.grid",
      "title": "Status with Maidenhead locator and symbol",
      "page": 81,
      "target": "info",
      "match": "^>[A-Ra-r]{2}[0-9]{2}(?:[A-Xa-x]{2})?[/\\\\A-Z0-9][!-~](?: |$)"
    },
    {
      "id": "status.beam",
      "title": "Status with beam heading/power ^HP",
      "page": 81,
      "target": "info",
      "match": "^>.*\\^[0-9A-Z][1-9:;<=>?@A-K]$"
    },
    {
      "id": "thirdparty",
      "title": "Third-party packet (})",
      "page": 85,
      "target": "info",
      "match": "^\\}"
    },
    {
      "id": "thirdparty.tnc2",
      "title": "Third-party header in TNC-2 format",
      "page": 85,
      "target": "info",
      "match": "^\\}[^>:]+>[^>:,]+(?:,[^>:,]+)*:"
    },
    {
      "id": "thirdparty.aea",
      "title": "Third-party header in AEA format",
      "page": 85,
      "target": "info",
      "match": "^\\}[^>:,]+(?:>[^>:,]+){2,}:"
    },
    {
      "id": "userdefined",
      "title": "User-defined data ({UX)",
      "page": 87,
      "target": "info",
      "match": "^\\{[^{]"
    },
    {
      "id": "userdefined.experimental",
      "title": "Experimental user-defined data ({{)",
      "page": 87,
      "target": "info",
      "match": "^\\{\\{"
    },
    {
      "id": "invalid",
      "title": "Invalid or test data (,)",
      "page": 89,
      "target": "info",
      "match": "^,"
    },
    {
      "id": "nonaprs",
      "title": "Non-APRS beacon (no recognised data type)",
      "page": 89,
      "target": "info",
      "match": "^[^!-~]|^[\\\"(\\-\\\\\\]\\^0-9A-SU-Za-z|~]"
    },
    {
      "id": "symbol.overlay.numeric",
      "title": "Uncompressed position with numeric overlay (0-9)",
      "page": 91,
      "target": "info",
      "match": "^(?:[!=]|[/@][0-9]{6}[zh/])[0-9 ]{4}\\.[0-9 ]{2}[NS][0-9][0-9 ]{5}\\.[0-9 ]{2}[EW]"
    },
    {
      "id": "symbol.overlay.alpha",
      "title": "Uncompressed position with letter overlay (A-Z)",
      "page": 91,
      "target": "info",
      "match": "^(?:[!=]|[/@][0-9]{6}[zh/])[0-9 ]{4}\\.[0-9 ]{2}[NS][A-Z][0-9 ]{5}\\.[0-9 ]{2}[EW]"
    },
    {
      "id": "symbol.alternate",
      "title": "Alternate symbol table without overlay (\\)",
      "page": 91,
      "target": "info",
      "match": "^(?:[!=]|[/@][0-9]{6}[zh/])(?:[0-9 ]{4}\\.[0-9 ]{2}[NS]\\\\[0-9 ]{5}\\.[0-9 ]{2}[EW]|\\\\[!-{]{8})"
    }
  ]
}
