      "target": "info",
      "match": "^[`'\\x1c\\x1d].{4}[\\x20\\x21\\x22\\x23\\x2a\\x2b\\x2c\\x2d\\x34\\x35\\x36\\x37\\x3e\\x3f\\x40\\x41\\x48\\x49\\x4a\\x4b\\x52\\x53\\x54\\x55\\x5c\\x5d\\x5e\\x5f\\x66\\x67\\x68\\x69\\x70\\x71\\x72\\x73\\x7a\\x7b\\x7c\\x7d]"
    },
    {
      "id": "comp.southeast",
      "title": "Compressed position south of the equator and east of Greenwich",
      "page": 38,
      "target": "info",
      "match": "^(?:[!=]|[/@][0-9]{6}[zh/])[/\\\\A-Za-j][O-{][!-{]{3}[O-{][!-{]{3}"
    },
    {
      "id": "dest.generic",
      "title": "Generic APRS destination (BEACON, CQ, QST, ID, WX…)",
      "page": 13,
      "target": "dest",
      "match": "^(?:AIR|ALL|BEACON|CQ|GPS|DF|DGPS|DRILL|DX|ID|JAVA|MAIL|MICE|QST|QTH|RTCM|SKY|SPACE|SPC|SYM|TEL|TEST|TLM|WX|ZIP)[A-Z0-9]{0,4}$"
