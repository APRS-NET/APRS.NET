    {
      "id": "mice.lon.110-179",
      "title": "Mic-E longitude 110–179° (offset +100, d+28 = & .. k)",
      "page": 47,
      "target": "line",
      "match": "^[^>]+>(?=[0-9A-LP-Z]{3}[0-9LP-Z]{3}(?:-[0-9]{1,2})?[,:])[0-9A-LP-Z]{3}[0-9LP-Z][P-Z][0-9LP-Z](?:-[0-9]{1,2})?(?:,[^:]*)?:[`'\\x1c\\x1d][&-k]"
