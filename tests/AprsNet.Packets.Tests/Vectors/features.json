{
  "features": [
    {
      "id": "ext.csespd.unknown",
      "title": "Course/speed unknown (.../... or spaces)",
      "page": 27,
      "target": "info",
      "match": "(?:^(?:[!=]|[/@][0-9]{6}[zh/])[0-9 ]{4}\\.[0-9 ]{2}[NS][/\\\\0-9A-Z][0-9 ]{5}\\.[0-9 ]{2}[EW]|^[;)].*?[0-9 ]{4}\\.[0-9 ]{2}[NS][/\\\\0-9A-Z][0-9 ]{5}\\.[0-9 ]{2}[EW])[^_](?:\\.{3}| {3})/(?:\\.{3}| {3})"
    },
    {
      "id": "ext.csespd.zero",
      "title": "Course/speed 000/000",
      "page": 27,
      "target": "info",
      "match": "(?:^(?:[!=]|[/@][0-9]{6}[zh/])[0-9 ]{4}\\.[0-9 ]{2}[NS][/\\\\0-9A-Z][0-9 ]{5}\\.[0-9 ]{2}[EW]|^[;)].*?[0-9 ]{4}\\.[0-9 ]{2}[NS][/\\\\0-9A-Z][0-9 ]{5}\\.[0-9 ]{2}[EW])[^_]000/000"
    },
    {
      "id": "ext.phg.directional",
      "title": "PHG with a directional antenna (d = 1–8)",
      "page": 28,
      "target": "info",
      "match": "PHG[0-9][0-9:;<=>?@A-Z][0-9][1-8]"
    },
    {
      "id": "dti.unused",
      "title": "Unused data type identifier (\" ( - \\ ] ^)",
      "page": 17,
      "target": "info",
      "match": "^[\"(\\-\\\\\\]^]"
    },
    {
      "id": "wx.luminosity.low",
      "title": "Weather luminosity L (0–999 W/m²)",
      "page": 64,
      "target": "info",
      "match": "_.*L[0-9]{3}"
    },
    {
      "id": "wx.luminosity.high",
      "title": "Weather luminosity l (1000+ W/m²)",
      "page": 64,
      "target": "info",
      "match": "_.*l[0-9]{3}"
    },
    {
      "id": "wx.humidity.100",
      "title": "Weather humidity h00 (100%)",
      "page": 64,
      "target": "info",
      "match": "_.*h00(?![0-9])"
    },
    {
      "id": "wx.missing.pressure",
      "title": "Weather pressure missing (b..... or spaces)",
      "page": 64,
      "target": "info",
      "match": "_.*b(?:\\.{5}| {5})"
    },
    {
      "id": "msg.plain",
      "title": "Plain message: no identifier, not telemetry/ack/rej/query",
      "page": 71,
      "target": "info",
      "match": "^:(?!BLN|NWS)[^:]{9}:(?!ack|rej|\\?|PARM\\.|UNIT\\.|EQNS\\.|BITS\\.)[^{]*$"
    },
    {
      "id": "msg.email",
      "title": "Message to EMAIL",
      "page": 71,
      "target": "info",
      "match": "^:EMAIL {4}:"
    },
    {
      "id": "msg.heard",
      "title": "?APRSH response (CALL HEARD: …)",
      "page": 79,
      "target": "info",
      "match": "^:[^:]{9}:[A-Z0-9-]+ HEARD:"
    },
    {
      "id": "msg.trace",
      "title": "?APRST/PING? response (route trace)",
      "page": 79,
      "target": "info",
      "match": "^:[^:]{9}:[A-Z0-9-]+>[^:]+:$"
    },
    {
      "id": "mice.msg.unknown",
      "title": "Mic-E with mixed standard and custom bits (unknown message)",
      "page": 45,
      "target": "line",
      "match": "^[^>]+>(?=[0-9A-LP-Z]{3}[0-9LP-Z]{3}(?:-[0-9]{1,2})?[,:])(?=.{0,2}[P-Z])(?=.{0,2}[A-K])[0-9A-LP-Z]{3}[0-9LP-Z]{3}(?:-[0-9]{1,2})?(?:,[^:]*)?:[`'\\x1c\\x1d]"
    },
