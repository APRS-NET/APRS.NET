    {
      "id": "mice.dc.plain",
      "title": "Mic-E DC+28 byte, course hundreds 0–3",
      "page": 51,
      "target": "info",
      "match": "^[`'\\x1c\\x1d].{4}[\\x1c\\x1d\\x1e\\x1f\\x26\\x27\\x28\\x29\\x30\\x31\\x32\\x33\\x3a\\x3b\\x3c\\x3d\\x44\\x45\\x46\\x47\\x4e\\x4f\\x50\\x51\\x58\\x59\\x5a\\x5b\\x62\\x63\\x64\\x65\\x6c\\x6d\\x6e\\x6f\\x76\\x77\\x78\\x79]"
