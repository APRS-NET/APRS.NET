      "target": "line",
      "match": "^[^>]+>(?=[0-9A-LP-Z]{3}[0-9LP-Z]{3}(?:-[0-9]{1,2})?[,:])[0-9A-LP-Z]{3}[0-9LP-Z][0-9L][0-9LP-Z](?:-[0-9]{1,2})?(?:,[^:]*)?:[`'\\x1c\\x1d]"
    },
    {
      "id": "mice.lon.100-109",
      "title": "Mic-E longitude 100–109° (offset +100, d+28 = l..u)",
      "page": 47,
      "target": "line",
      "match": "^[^>]+>(?=[0-9A-LP-Z]{3}[0-9LP-Z]{3}(?:-[0-9]{1,2})?[,:])[0-9A-LP-Z]{3}[0-9LP-Z][P-Z][0-9LP-Z](?:-[0-9]{1,2})?(?:,[^:]*)?:[`'\\x1c\\x1d][l-u]"
