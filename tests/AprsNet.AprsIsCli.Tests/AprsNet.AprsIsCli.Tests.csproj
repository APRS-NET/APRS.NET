<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- the CLI targets net10.0 only -->
    <TargetFrameworks />
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xUnit v3 test projects are executables. xunit.v3.mtp-off keeps the VSTest runner for dotnet test. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="GitHubActionsTestLogger" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../apps/AprsNet.AprsIsCli/AprsNet.AprsIsCli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../AprsNet.AprsIsTcpClient.Tests/FakeAprsTransport.cs" Link="FakeAprsTransport.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
