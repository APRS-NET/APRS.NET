    {
      "id": "ch10.mice-telemetry-5",
      "title": "Mic-E telemetry, 5 hex channels ('7200007100)",
      "spec": {
        "document": "APRS101",
        "page": 54,
        "section": "Mic-E Telemetry Data"
      },
      "status": "superseded",
      "features": [
        "mice",
        "mice.telemetry.legacy"
      ],
      "packet": "N0CALL>T4SQZZ:`(_fn\"Oj/'7200007100",
      "expect": {
        "type": "mice",
        "telemetry": [
          114,
          0,
          0,
          113,
          0
        ]
      },
      "notes": "APRS 1.2 reuses ' and ` as Mic-E type codes and deprecates Mic-E telemetry (A12-MICE-04)."
    },
