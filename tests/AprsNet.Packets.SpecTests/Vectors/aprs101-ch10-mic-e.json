        "mice.lon.0-9"
      ],
      "packet": "N0CALL>S32UPT:`{]Nn\"O>/",
      "expect": {
        "type": "mice",
        "longitude": -5.091667,
        "speed": 20,
        "course": 251
      },
      "notes": "Minutes byte ']' = 5 (0-9 minute encoding, 93-28-60), hundredths 'N' = 50."
    },
