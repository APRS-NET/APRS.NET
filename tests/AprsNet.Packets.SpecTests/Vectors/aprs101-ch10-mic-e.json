{
  "$schema": "./vectors.schema.json",
  "vectors": [
    {
      "id": "ch10.mice-ambiguity-example",
      "title": "Mic-E spec example: destination T4SQZZ with info (_fn\"Oj/ (ambiguity 2)",
      "spec": {
        "document": "APRS101",
        "page": 53,
        "section": "Example of Decoding the Information Field Data / Mic-E Position Ambiguity"
      },
      "status": "normative",
      "features": [
        "mice",
        "mice.current",
        "mice.ambiguity",
        "mice.lon.offset100"
      ],
      "packet": "N0CALL>T4SQZZ:`(_fn\"Oj/",
      "expect": {
        "type": "mice",
        "current": true,
        "latitude": 44.516667,
        "longitude": -112.116667,
        "ambiguity": 2,
        "speed": 20,
        "course": 251,
        "symbol": {
          "table": "/",
          "code": "j"
        },
        "messageCode": "M2",
        "messageName": "In Service"
      },
      "notes": "Spec decodes the longitude as 112°07.74'W; with destination ambiguity 2 the hundredths are dropped (112°07'W)."
    },
    {
      "id": "ch10.mice-returning",
      "title": "Mic-E S32U6T (33°25.64'N, M3 Returning, +0 offset, West)",
      "spec": {
        "document": "APRS101",
        "page": 44,
        "section": "Destination Address Field Encoding"
      },
      "status": "derived",
      "features": [
        "mice",
        "mice.current",
        "mice.msg.standard",
        "mice.lon.10-99"
      ],
      "packet": "N0CALL>S32U6T:`dYgoXt>/",
      "expect": {
        "type": "mice",
        "latitude": 33.427333,
        "longitude": -72.029167,
        "ambiguity": 0,
        "speed": 36,
        "course": 88,
        "symbol": {
          "table": "/",
          "code": ">"
        },
        "messageCode": "M3",
        "messageName": "Returning"
      },
      "notes": "Destination from the spec example; information field built from the spec tables (072°01.75'W, 36 kn, course 88)."
    },
