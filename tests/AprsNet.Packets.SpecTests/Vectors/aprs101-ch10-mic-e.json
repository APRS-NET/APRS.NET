    {
      "id": "ch10.mice-speed-encoding-a",
      "title": "Mic-E speed/course alternate encoding 's@z' = 73 kn, 294°",
      "spec": {
        "document": "APRS101",
        "page": 50,
        "section": "Speed and Course Encoding"
      },
      "status": "normative",
      "features": [
        "mice",
        "mice.sp.high",
        "mice.dc.offset4"
      ],
      "packet": "N0CALL>T4SQZZ:`(_fs@z>/",
      "expect": {
        "type": "mice",
        "speed": 73,
        "course": 294
      },
      "notes": "The spec defines two encodings for 0–199 kn and DC+28; both must decode identically."
    },
    {
      "id": "ch10.mice-speed-encoding-b",
      "title": "Mic-E speed/course alternate encoding '#<z' = 73 kn, 294°",
      "spec": {
        "document": "APRS101",
