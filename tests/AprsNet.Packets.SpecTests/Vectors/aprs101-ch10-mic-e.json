        "mice.dc.plain"
      ],
      "packet": "N0CALL>T4SQZZ:`(_f#<z>/",
      "expect": {
        "type": "mice",
        "speed": 73,
        "course": 294
      },
      "notes": "The spec defines two encodings for 0–199 kn and DC+28; both must decode identically."
    },
    {
      "id": "ch10.mice-kenwood-d700-old-dti",
      "title": "Mic-E with ' DTI and ] type code = TM-D700 current data",
      "spec": {
        "document": "APRS101",
        "page": 55,
        "section": "Mic-E Status Text"
      },
      "status": "normative",
      "features": [
        "mice",
        "mice.old",
        "mice.status.d700"
      ],
      "packet": "N0CALL>T4SQZZ:'(_fn\"Oj/]Hello",
      "expect": {
        "type": "mice",
        "current": true,
        "device": "TM-D700",
        "statusText": "Hello"
      },
      "notes": "TM-D700 uses ' for current data; detect by ' at position 1 and ] at position 10."
    },
