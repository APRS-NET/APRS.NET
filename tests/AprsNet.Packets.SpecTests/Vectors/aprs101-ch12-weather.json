{
  "$schema": "./vectors.schema.json",
  "vectors": [
    {
      "id": "ch12.raw-ultimeter-bang",
      "title": "Raw weather (Ultimeter 2000)",
      "spec": {
        "document": "APRS101",
        "page": 62,
        "section": "Raw Weather Reports"
      },
      "status": "normative",
      "features": [
        "wx.raw.ultimeter"
      ],
      "packet": "N0CALL>APRS:!!006B005803500000----03E9--------002105140000005D",
      "expect": {
        "type": "rawWeather",
        "station": "Ultimeter 2000"
      },
      "notes": "APRS101 does not define the raw field layout; only the type is asserted. APRS 1.1 discourages raw formats on RF."
    },
