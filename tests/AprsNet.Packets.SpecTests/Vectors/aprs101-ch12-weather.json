    {
      "id": "ch12.complete-compressed-ts",
      "title": "Complete weather report, compressed position with timestamp",
      "spec": {
        "document": "APRS101",
        "page": 66,
        "section": "Complete Weather Reports"
      },
      "status": "normative",
      "features": [
        "dti.pos.ts.msg",
        "pos.compressed",
        "wx.complete"
      ],
      "packet": "N0CALL>APRS:@092345z/5L!!<*e7_7P[g005t077r000p000P000h50b09900wRSW",
      "expect": {
        "type": "weather",
        "latitude": 49.5,
        "longitude": -72.750004,
        "weather": {
          "windDirection": 88,
          "windSpeed": 36.2,
          "windGust": 5,
          "temperatureF": 77,
          "humidity": 50,
          "pressureMb": 990.0
        }
      },
      "notes": "Wind direction/speed come from the compressed cs bytes (course 88, 36.2)."
    },
    {
      "id": "ch12.complete-compressed",
      "title": "Complete weather report, compressed position, no timestamp",
      "spec": {
        "document": "APRS101",
        "page": 66,
        "section": "Complete Weather Reports"
      },
      "status": "erratum-corrected",
      "features": [
        "dti.pos.nots.msg",
        "pos.compressed",
        "wx.complete"
      ],
      "packet": "N0CALL>APRS:=/5L!!<*e7_7P[g005t077r000p000P000h50b09900wRSW",
      "expect": {
        "type": "weather",
        "weather": {
          "windDirection": 88,
          "windSpeed": 36.2,
          "windGust": 5,
          "temperatureF": 77
        }
      },
      "notes": "The spec example has an extra '>' before the '_' symbol (=/5L!!<*e7>_7P[…), making it 14 bytes."
    },
    {
      "id": "ch12.object-weather",
      "title": "Weather in an object",
      "spec": {
        "document": "APRS101",
        "page": 66,
        "section": "Complete Weather Reports"
      },
      "status": "erratum-corrected",
      "features": [
        "object.live",
        "wx.object",
        "wx.complete"
      ],
      "packet": "N0CALL>APRS:;BRENDA   *092345z4903.50N/07201.75W_220/004g005t077r000p000P000h50b09900wRSW",
      "expect": {
        "type": "object",
        "name": "BRENDA",
        "weather": {
          "windDirection": 220,
          "windSpeed": 4,
          "windGust": 5,
          "temperatureF": 77,
          "rain1h": 0,
          "rain24h": 0,
          "rainMidnight": 0,
          "humidity": 50,
          "pressureMb": 990.0
        }
      },
      "notes": "The spec's first example omits the object timestamp; its second example has a 4-digit pressure (b0990). Both corrected."
    },
