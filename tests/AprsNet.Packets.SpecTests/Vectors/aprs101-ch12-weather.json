    {
      "id": "ch12.positionless",
      "title": "Positionless weather report",
      "spec": {
        "document": "APRS101",
        "page": 63,
        "section": "Positionless Weather Reports"
      },
      "status": "normative",
      "features": [
        "wx.positionless",
        "time.mdhm"
      ],
      "packet": "N0CALL>APRS:_10090556c220s004g005t077r000p000P000h50b09900wRSW",
      "expect": {
        "type": "weather",
        "timestamp": {
          "format": "MDHM",
          "month": 10,
          "day": 9,
          "hour": 5,
          "minute": 56
        },
        "weather": {
          "windDirection": 220,
          "windSpeed": 4,
          "windGust": 5,
          "temperatureF": 77,
          "rain1h": 0,
          "rain24h": 0,
          "rainMidnight": 0,
          "humidity": 50,
          "pressureMb": 990.0,
          "software": "w",
          "unit": "RSW"
        }
      },
      "notes": "Positionless wind speed is mph (p.64). 'w' is not in the software-type list; it is still the S byte."
    },
    {
      "id": "ch12.positionless-missing",
      "title": "Positionless weather with missing sensors (dots)",
      "spec": {
        "document": "APRS101",
        "page": 64,
        "section": "Positionless Weather Data"
      },
      "status": "normative",
      "features": [
        "wx.positionless",
        "wx.missing"
      ],
      "packet": "N0CALL>APRS:_10090556c...s...g...t...P012Jim",
      "expect": {
        "type": "weather",
        "weather": {
          "windDirection": null,
          "windSpeed": null,
          "windGust": null,
          "temperatureF": null,
          "rainMidnight": 12
        }
      },
      "notes": "'Jim' is free text after the fields; the spec does not say whether it is S+uuuu."
    },
    {
      "id": "ch12.complete",
      "title": "Complete weather report, no timestamp",
      "spec": {
        "document": "APRS101",
        "page": 65,
        "section": "Complete Weather Reports"
      },
      "status": "normative",
      "features": [
        "dti.pos.nots.nomsg",
        "wx.complete",
        "wx.rain",
        "wx.humidity",
        "wx.pressure"
      ],
      "packet": "N0CALL>APRS:!4903.50N/07201.75W_220/004g005t077r000p000P000h50b09900wRSW",
      "expect": {
        "type": "weather",
        "latitude": 49.058333,
        "longitude": -72.029167,
        "symbol": {
          "table": "/",
          "code": "_"
        },
        "weather": {
          "windDirection": 220,
          "windSpeed": 4,
          "windGust": 5,
          "temperatureF": 77,
          "rain1h": 0,
          "rain24h": 0,
          "rainMidnight": 0,
          "humidity": 50,
          "pressureMb": 990.0,
          "software": "w",
          "unit": "RSW"
        }
      },
      "notes": "Wind speed in DIR/SPD: p.27 says knots, p.64 (positionless) says mph. Real stations send mph. Raw value asserted."
    },
