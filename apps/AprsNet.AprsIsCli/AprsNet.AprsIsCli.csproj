<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks />
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>aprscli</AssemblyName>
    <RootNamespace>AprsNet.AprsIsCli</RootNamespace>
    <!-- Published as a .NET tool with the libraries, at the same version: dotnet tool install -g AprsNet.AprsIsCli. -->
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>aprscli</ToolCommandName>
    <PackageId>AprsNet.AprsIsCli</PackageId>
    <Description>APRS.NET command-line tool: listen to APRS-IS, parse and replay packets, send as your callsign, and compute passcodes.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AprsNet.AprsIsCli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AprsNet.AprsIsTcpClient\AprsNet.AprsIsTcpClient.csproj" />
    <ProjectReference Include="..\..\src\AprsNet.Symbols\AprsNet.Symbols.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
