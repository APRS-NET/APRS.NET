<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>aprscli</AssemblyName>
    <RootNamespace>AprsNet.AprsIsCli</RootNamespace>
    <!-- Published as a .NET tool with the libraries, at the same version: dotnet tool install -g AprsNet.AprsIsCli. -->
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>aprscli</ToolCommandName>
    <PackageId>AprsNet.AprsIsCli</PackageId>
    <Description>APRS.NET command-line tool: listen to APRS-IS, parse and replay packets, send as your callsign, serve a feed to local APRS-IS clients, and compute passcodes.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AprsNet.AprsIsCli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AprsNet.AprsIsTcpClient\AprsNet.AprsIsTcpClient.csproj" />
    <ProjectReference Include="..\..\src\AprsNet.Gateway\AprsNet.Gateway.csproj" />
    <ProjectReference Include="..\..\src\AprsNet.IGate\AprsNet.IGate.csproj" />
    <ProjectReference Include="..\..\src\AprsNet.Beacons\AprsNet.Beacons.csproj" />
    <ProjectReference Include="..\..\src\AprsNet.Gps\AprsNet.Gps.csproj" />
    <ProjectReference Include="..\..\src\AprsNet.Symbols\AprsNet.Symbols.csproj" />
    <ProjectReference Include="..\..\src\AprsNet.Packets.Json\AprsNet.Packets.Json.csproj" />
    <ProjectReference Include="..\..\src\AprsNet.Kiss\AprsNet.Kiss.csproj" />
    <ProjectReference Include="..\..\src\AprsNet.Kiss.Serial\AprsNet.Kiss.Serial.csproj" />
    <ProjectReference Include="..\..\src\AprsNet.Messaging\AprsNet.Messaging.csproj" />
    <ProjectReference Include="..\..\src\AprsNet.Corpus\AprsNet.Corpus.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Tomlyn" />
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
