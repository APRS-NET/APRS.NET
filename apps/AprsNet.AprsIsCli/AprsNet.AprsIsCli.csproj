<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks />
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>aprscli</AssemblyName>
    <RootNamespace>AprsNet.AprsIsCli</RootNamespace>
    <!-- Not published yet: the tool is mainly used to capture test traffic. To publish it as a .NET tool later, set
         IsPackable to true; PackAsTool and the tool settings below are already in place. -->
    <IsPackable>false</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>aprscli</ToolCommandName>
    <PackageId>AprsNet.AprsIsCli</PackageId>
    <Description>APRS.NET command-line tool: listen, parse, send, passcode and replay.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AprsNet.AprsIsCli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AprsNet.AprsIsTcpClient\AprsNet.AprsIsTcpClient.csproj" />
    <ProjectReference Include="..\..\src\AprsNet.Symbols\AprsNet.Symbols.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
