# OpenTelemetry for the APRS.NET services: logs and metrics over OTLP, to an OpenTelemetry Collector or anything else
# that takes OTLP. Every aprsnet service reads this file; restart them after changing it:
#
#   sudo systemctl restart 'aprsnet-*@*'
#
# Without an endpoint, nothing is exported and the services only log to the journal. install.sh never changes this
# file, and only root can read it, so headers with a token are safe here.
#
# Each service reports service.name aprsnet-tnc-share or aprsnet-serve, and service.instance.id the name of its config
# file, such as tncx. Don't set OTEL_SERVICE_NAME here: it would name every service the same.
#
# What is exported (the aprscli README and docs/metrics.md have the details):
# - metrics: the AprsNet.* meters, such as frames heard and sent, apps and clients connected, packets served and
#   gated, and how long frames wait for the TNC, every 60 s;
# - logs: what each service writes to the journal, such as apps connecting and the TNC lost, with fields to query on.
#   Add log-packets = true to a config file to log each packet too.

# The collector's OTLP receiver. gRPC on port 4317 is the default; for OTLP over HTTP, use port 4318 and set the
# protocol below.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://collector.lan:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Headers for a collector that needs a token, as key=value pairs separated by commas.
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer 0123456789abcdef

# More attributes on everything the services export, such as where they run.
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=home,host.name=radio-pi

# How often metrics are exported, in milliseconds.
# OTEL_METRIC_EXPORT_INTERVAL=60000
