# Shares one TNC with KISS apps over TCP: aprscli tnc share, reading /etc/aprsnet/tnc-share/<name>.toml.
#
#   sudo systemctl enable --now aprsnet-tnc-share@tncx     # /etc/aprsnet/tnc-share/tncx.toml
#
# Installed by apps/services/install.sh. Change it with `systemctl edit`, not here: install.sh replaces this file.

[Unit]
Description=APRS.NET TNC share %i (KISS over TCP)
Documentation=https://github.com/APRS-NET/APRS.NET/tree/main/apps/services
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/aprsnet/tnc-share/%i.toml

[Service]
Type=exec
User=aprsnet
Group=aprsnet
# The serial port belongs to the dialout group.
SupplementaryGroups=dialout
EnvironmentFile=/etc/aprsnet/environment
EnvironmentFile=-/etc/aprsnet/otel.env
ExecStart=/opt/aprsnet/aprscli tnc share --config /etc/aprsnet/tnc-share/%i.toml
# A lost TNC is reconnected inside aprscli; this restarts it when it stops for anything else. Exit code 3 is a mistake
# in the settings, which a restart won't fix.
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=3
SyslogIdentifier=aprsnet-tnc-share@%i

StateDirectory=aprsnet
Environment=HOME=/var/lib/aprsnet DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1
# How the service shows in OpenTelemetry: service.name, and service.instance.id from the config file's name.
Environment=OTEL_SERVICE_NAME=aprsnet-tnc-share APRSNET_INSTANCE=%i
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
UMask=0027

[Install]
WantedBy=multi-user.target
